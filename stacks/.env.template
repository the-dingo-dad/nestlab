PUID=99
PGID=100
TZ=Australia/Melbourne
UMASK=022
DATA_ROOT=/mnt/user/data
SCRATCH_ROOT=/mnt/user/scratch
APPDATA_ROOT=/mnt/user/appdata
ROOT_URL=domain.au
EMAIL=email@domain.au
HA_TOKEN=ha
MQTT_USERNAME=user
MQTT_PASSWORD=pass

# TimescaleDB — shared by both prod + dev instances
POSTGRES_USER=tsdb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metrics

# Telegraf MQTT source
MQTT_URL=tcp://mosquitto:1883
MQTT_TOPICS=telegraf/#

# ── Network names (docker network names) ──
NET_PROXY=nestlab-proxy
NET_DOWNLOAD=nestlab-download
NET_MQTT=nestlab-mqtt
NET_SYS=nestlab-sys
NET_SQL=nestlab-sql
NET_HA=nestlab-ha
NET_IOT=nestlab-iot
NET_LAN=nestlab-lan
NET_SRV=nestlab-srv

# ── Host network definitions — used by `docker network create`, NOT read by compose ──
# bridge externals
PROXY_SUBNET=172.67.0.0/24
PROXY_GATEWAY=172.67.0.1
DOWNLOAD_SUBNET=172.65.0.0/24
DOWNLOAD_GATEWAY=172.65.0.1
MQTT_SUBNET=172.19.0.0/16
MQTT_GATEWAY=172.19.0.1
SYS_SUBNET=172.63.0.0/24
SYS_GATEWAY=172.63.0.1
SQL_SUBNET=172.22.0.0/16
SQL_GATEWAY=172.22.0.1
# macvlan externals
# NB: sbh-home (VLAN 10) is the UNTAGGED/native network on br0, so the parent is
# br0, not br0.10. Tagged VLANs (services=20, iot=30) use their br0.<vlan> subif.
LAN_PARENT=br0
LAN_SUBNET=192.168.10.0/24
LAN_GATEWAY=192.168.10.1
SRV_PARENT=br0.20
SRV_SUBNET=192.168.20.0/24
SRV_GATEWAY=192.168.20.1
IOT_PARENT=br0.30
IOT_SUBNET=192.168.30.0/24
IOT_GATEWAY=192.168.30.1

# ── Compose-managed bridge (read by compose) ──
HA_NET_SUBNET=172.18.0.0/16

# ── Container static IPs (compose) ──
TRAEFIK_PROXY_IP=172.67.0.128
TRAEFIK_SYS_IP=172.63.0.128
TRAEFIK_LAN_IP=192.168.10.145
TRAEFIK_SRV_IP=192.168.20.145
HOMEASSISTANT_HA_IP=172.18.0.2
APPDAEMON_HA_IP=172.18.0.4
HOMEASSISTANT_IOT_IP=192.168.30.145
ECOWITT_IOT_IP=192.168.30.147

# ── Container static MACs (compose) ──
TRAEFIK_LAN_MAC=02:42:c0:a8:14:01
TRAEFIK_SRV_MAC=02:42:c0:a8:14:02
HOMEASSISTANT_IOT_MAC=02:42:c0:a8:14:03
ECOWITT_IOT_MAC=02:42:c0:a8:14:05

# ── Hardware device paths ──
ZIGBEE_DEVICE=/dev/serial/by-id/usb-CHANGE-ME-if00-port0
